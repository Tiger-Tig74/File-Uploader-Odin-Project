<% layout('layout', { title: (currentFolder ? currentFolder.name : "My Files") + " - File Uploader" }) %>

<nav class="breadcrumbs">
  <a href="/folders">Root</a>
<% breadcrumbs.forEach(crumb => { %>
    / <a href="/folders/<%= crumb.id %>"><%= crumb.name %></a>
<% }) %>
</nav>

<form action="/folders" method="POST" class="inline-form" data-validate-folder>
  <input type="text" name="name" placeholder="New folder name" required maxlength="100" />
<% if (currentFolder) { %>
    <input type="hidden" name="parentId" value="<%= currentFolder.id %>" />
<% } %>
  <button type="submit">Create folder</button>
</form>

<form action="/files" method="POST" enctype="multipart/form-data" class="inline-form" data-upload-form>
  <input type="file" name="file" required />
<% if (currentFolder) { %>
    <input type="hidden" name="folderId" value="<%= currentFolder.id %>" />
<% } %>
  <button type="submit">Upload</button>
</form>

<h2>Folders</h2>
<% if (!folders.length) { %>
  <p class="muted">No folders here.</p>
<% } else { %>
  <ul class="grid">
<% folders.forEach(f => { %>
      <li class="card folder-card">
        <a href="/folders/<%= f.id %>">📁<%= f.name %></a>

        <details class="menu">
          <summary>⋯</summary>
          <form action="/folders/<%= f.id %>/rename" method="POST" class="inline-form">
            <input type="text" name="name" value="<%= f.name %>" required maxlength="100" />
            <button type="submit">Rename</button>
          </form>
          <form action="/folders/<%= f.id %>/delete" method="POST"
                data-confirm="Delete this folder and all of its contents?">
            <button class="danger" type="submit">Delete</button>
          </form>
        </details>
      </li>
<% }) %>
  </ul>
<% } %>

<h2>Files</h2>
<% if (!files.length) { %>
  <p class="muted">No files here.</p>
<% } else { %>
  <ul class="list">
<% files.forEach(f => { %>
      <li>
        <a href="/files/<%= f.id %>">📄<%= f.name %></a>
        <span class="muted">(<%= (f.size / 1024).toFixed(1) %> KB)</span>
        <a href="/files/<%= f.id %>/download" class="link-btn">Download</a>
      </li>
<% }) %>
  </ul>
<% } %>

<% if (currentFolder) { %>
  <section class="card share-box">
    <h3>Share this folder</h3>
    <form action="/share" method="POST" class="inline-form">
      <input type="hidden" name="folderId" value="<%= currentFolder.id %>" />
      <label>Expires in
        <input type="number" name="duration" min="1" max="30" value="7" required />
        day(s)
      </label>
      <button type="submit">Generate share link</button>
    </form>

<% if (shares && shares.length) { %>
      <h4>Active share links</h4>
      <ul class="list">
<% shares.forEach(s => { %>
          <li>
            <code>/share/<%= s.token %></code>
            <span class="muted">expires<%= new Date(s.expiresAt).toLocaleString() %></span>
            <form action="/share/<%= s.id %>/revoke" method="POST"
                  data-confirm="Revoke this share link?">
              <button class="danger" type="submit">Revoke</button>
            </form>
          </li>
<% }) %>
      </ul>
<% } %>
  </section>
<% } %>