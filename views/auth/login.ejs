<% layout('layout', {
     title: "Login - File Uploader",
     bodyClass: "auth-page",
     mainClass: "auth-wrap"
   }) %>

<section class="card">
  <h1>Sign in</h1>

<% if (errors && errors.length) { %>
    <ul class="errors">
<% errors.forEach(e => { %><li><%= e.msg %></li><% }) %>
    </ul>
<% } %>

  <form action="/auth/login" method="POST" class="stack">
    <label>Email
      <input type="email" name="email" value="<%= values?.email || '' %>" required />
    </label>
    <label>Password
      <input type="password" name="password" required />
    </label>
    <button type="submit">Sign in</button>
  </form>

  <p class="muted">No account? <a href="/auth/register">Create one</a></p>
</section>